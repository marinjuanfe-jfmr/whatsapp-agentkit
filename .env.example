# AgentKit — Agente de Arriendo Los Robles
# Copia este archivo como .env y llena tus datos:
#   cp .env.example .env
# NUNCA subas el archivo .env a GitHub.

# ── Anthropic API ──────────────────────────────────────────
# Obtener en: https://platform.anthropic.com/settings/api-keys
ANTHROPIC_API_KEY=

# ── Proveedor de WhatsApp ──────────────────────────────────
# Proveedor: ycloud
WHATSAPP_PROVIDER=ycloud

# ── YCloud ────────────────────────────────────────────────
# Obtener en: https://app.ycloud.com
YCLOUD_API_KEY=
YCLOUD_PHONE_NUMBER=+573243939750
YCLOUD_WEBHOOK_SECRET=

# ── Telegram (alertas al propietario) ─────────────────────
# Crear bot en @BotFather, obtener Chat ID en:
# https://api.telegram.org/botTU_TOKEN/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Google Calendar (agendamiento de visitas) ──────────────
# Credenciales OAuth en: https://console.cloud.google.com
GOOGLE_CALENDAR_ID=
GOOGLE_CREDENTIALS_JSON=

# ── Google Sheets (registro de leads) ─────────────────────
GOOGLE_SHEETS_ID=

# ── Multimedia (fotos y videos del apartamento) ───────────
# URLs públicas de las fotos/videos (Google Drive, Dropbox, etc.)
APARTMENT_PHOTO_1=
APARTMENT_PHOTO_2=
APARTMENT_PHOTO_3=
APARTMENT_VIDEO_1=

# ── Servidor ──────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Base de datos ─────────────────────────────────────────
# Local (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# Producción (Railway):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname
