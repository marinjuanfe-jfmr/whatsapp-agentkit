{
  "name": "whatsapp-agentkit",
  "version": "0.1.0",
  "description": "Framework for building autonomous agents that interact through WhatsApp",
  "main": "dist/index.js",
  "scripts": {
    "setup": "node scripts/setup.js && npm install",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "type-check": "tsc --noEmit",
    "validate-config": "node scripts/validate-config.js",
    "deploy": "railway up"
  },
  "keywords": [
    "whatsapp",
    "agent",
    "ai",
    "claude",
    "anthropic"
  ],
  "author": "Juan Felipe Marín",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "axios": "^1.7.0",
    "dotenv": "^16.4.0",
    "express": "^4.18.0",
    "typescript": "^5.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "prettier": "^3.1.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.7.0"
  }
}
